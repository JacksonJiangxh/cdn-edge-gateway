{
  "redis_host": "127.0.0.1",
  "redis_port": 6379,
  "redis_auth": null,

  "http_host": "0.0.0.0",
  "http_port": 7379,

  "threads": 4,

  "daemonize": false,

  "database": 0,

  "acl": [
    {
      "enabled": []
    },
    {
      "http_basic_auth": "esa:CHANGE_ME_STRONG_PASSWORD",
      "enabled": [ "GET", "SET", "SETEX", "DEL", "EXISTS", "PING" ]
    }
  ],

  "hiredis": {
    "keep_alive_sec": 15
  },

  "verbosity": 3,
  "logfile": "/dev/stderr"
}
